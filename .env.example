# Copie para .env (que está no .gitignore) e preencha.
# Token gerado em developers.facebook.com → Instagram →
# API setup with Instagram business login → Generate token.
# Permissões: só instagram_business_basic + instagram_business_manage_insights.
IG_ACCESS_TOKEN=

# Opcional: fixar a versão da API (ex.: v24.0). Vazio = versão padrão do app.
IG_API_VERSION=
